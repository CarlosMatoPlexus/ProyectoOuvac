    <formulas>
        <name>CaseNumberFormatted</name>
        <dataType>String</dataType>
        <expression>LPAD(SUBSTITUTE(TRIM({!Case_Number}), &quot; &quot;, &quot;&quot;), 8, &quot;0&quot;)</expression>
