<apex:page showHeader="false" sidebar="false" standardStylesheets="false">
<head>
<style>
           html, body {
               margin: 5% !important;
               padding: 0 !important;
               height: 0%;
/*               background-color: #0061A7;  Fondo del color deseado */
               font-family: Arial, sans-serif;
           }
           .banner-container {
               width: 90%;
               height: 250px;
               position: relative;
               overflow: hidden;
/*               background-color: #0061A7;  Asegura que no haya bordes blancos */
           }
           .slides {
               display: flex;
               transition: transform 1s ease-in-out;
               height: 100%;
           }
           .slide {
               min-width: 100%;
               height: 100%;
           }
           .slide img {
               width: 100%;
               height: 100%;
               object-fit: contain;
           }
</style>
</head>
<body>
<div class="banner-container">
<div class="slides">
<div class="slide">
<img src="/resource/LogoBannerFondoBlanco" alt="LogoBannerFondoBlanco"/>
</div>
</div>
</div>
</body>
</apex:page>